# Copie para .env.local e preencha. Nunca commite o .env.local.
DATABASE_URL="postgresql://..."      # pooler do Supabase, porta 6543 (transaction mode)
AUTH_SECRET=""                       # segredo do NextAuth (gere com: npx auth secret)
CRON_SECRET=""                       # Bearer token dos endpoints de cron
SUPABASE_SERVICE_ROLE_KEY=""         # Storage (bucket "documentos")
RESEND_API_KEY=""                    # opcional: sem ele, e-mails são só logados no console
RESEND_FROM_EMAIL=""                 # opcional
GOOGLE_BOOKS_API_KEY=""              # opcional
